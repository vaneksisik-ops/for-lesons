bit = float(input("напишите колличество бит"))
user_choise = int(input(f"Choose\n"
            f"1.KB\n"
            f"2.MB\n"
            f"3.GB\n"
            f"4.TB"))
units = {1: (1024, "KB"),
         2: (1024**2, "MB"),
         3: (1024**3, "GB"),
         4: (1024**4, "TB")}
if user_choise in units:
    divider, units_name = units[user_choise]
    res = bit / divider
    print(res)

