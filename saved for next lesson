rows = 5
cols = 5

matrix = []

# Заполнение матрицы циклом
for r in range(rows):
    row = []
    for c in range(cols):
        if r % 2 == 0 and c % 2 == 0:
            row.append(".")
        elif r == c:
            row.append(".")
        elif r == 1 and c == 3:
            row.append(".")
        elif r == 3 and c == 1:
            row.append(".")
        else:
            row.append("*")
    matrix.append(row)

# Старый (ваш) способ вывода на экран
for row in matrix:
    for item in row:
        print(item, end=" ")
    print()
